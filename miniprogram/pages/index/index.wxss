/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  /* 自定义 tabBar 是 fixed 悬浮层，不再自动占位，这里手动留出高度 + iOS 安全区 */
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

/* ---------- 沉浸式顶部 ---------- */

.top {
  position: relative;
  padding-bottom: 100rpx;
  background: linear-gradient(158deg, #3a7bff 0%, #2b6ef2 45%, #1a4fd0 100%);
  overflow: hidden;
}

/* 两个低透明度圆形做背景层次，不引入图片 */
.top::before,
.top::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.top::before {
  right: -120rpx;
  top: -80rpx;
  width: 380rpx;
  height: 380rpx;
}

.top::after {
  left: -100rpx;
  bottom: 20rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.06);
}

.brand {
  position: relative;
  z-index: 1;
  padding: 36rpx 32rpx 0;
  text-align: center;
}

.brand-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.brand-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ---------- 白色面板：分类入口 + 轮播图 ---------- */

.sheet {
  position: relative;
  z-index: 1;
  margin-top: -64rpx;
  padding-bottom: 24rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}

/* 三个分类入口：浅色渐变底卡 + 彩色圆角图标块（白色线性图标，内联 SVG，不依赖字体/emoji） */
.category-grid {
  display: flex;
  gap: 16rpx;
  padding: 28rpx 24rpx 0;
}

.category-card {
  flex: 1;
  min-width: 0;
  padding: 26rpx 8rpx 24rpx;
  text-align: center;
  border: 1rpx solid transparent;
  border-radius: 24rpx;
}

.category-card:active {
  opacity: 0.85;
}

.cat-house {
  background: linear-gradient(180deg, #e9f1ff 0%, #f7fafe 100%);
  border-color: #dbe7ff;
}

.cat-secondhand {
  background: linear-gradient(180deg, #fdeee1 0%, #fff9f3 100%);
  border-color: #fae2cb;
}

.cat-offer {
  background: linear-gradient(180deg, #e6f7ec 0%, #f5fdf8 100%);
  border-color: #d5efdd;
}

.category-icon {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 16rpx;
  border-radius: 30rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 56rpx 56rpx;
  box-shadow: 0 8rpx 16rpx rgba(43, 110, 242, 0.18);
}

.icon-house {
  background-color: #4c86f5;
  background-image: url("data:image/svg+xml;base64,");
}

.icon-secondhand {
  background-color: #f6a04d;
  background-image: url("data:image/svg+xml;base64,");
  box-shadow: 0 8rpx 16rpx rgba(246, 160, 77, 0.22);
}

.icon-offer {
  background-color: #58c07d;
  background-image: url("data:image/svg+xml;base64,");
  box-shadow: 0 8rpx 16rpx rgba(88, 192, 125, 0.22);
}

.category-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  white-space: nowrap;
}

.category-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8b93a1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 公告栏（原轮播图位置，暂时替换） ---------- */

.notice {
  display: flex;
  align-items: center;
  height: 84rpx;
  margin: 20rpx 24rpx 0;
  padding: 0 20rpx;
  background: #f5f7fb;
  border-radius: 16rpx;
}

.notice-badge {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #ffffff;
  background: var(--color-primary);
  border-radius: 8rpx;
}

.notice-track {
  flex: 1;
  min-width: 0;
  height: 40rpx;
  line-height: 40rpx;
  overflow: hidden;
}

/* 漂浮字幕：文字从右侧滑入、向左滑出，走完切下一条（由 onNoticeEnd 驱动） */
.notice-text {
  display: inline-block;
  padding-left: 100%;
  font-size: 26rpx;
  color: #4a5160;
  white-space: nowrap;
  animation-timing-function: linear;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}

/* 两条同名不同名的相同动画，交替使用以强制重启动画 */
@keyframes noticeA {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-100%);
  }
}

@keyframes noticeB {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-100%);
  }
}

/* ---------- 置顶信息 ---------- */

.section-head {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx 16rpx;
}

.section-bar {
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* ---------- 信息卡片：左图 + 右侧四段 ---------- */

.cards {
  padding: 0 24rpx;
}

.item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.item:active {
  background: #fafbfc;
}

/* 有图：图片高度 = 条目内容总高（216rpx），标签底边与图片底边齐平 */
.item-cover {
  flex-shrink: 0;
  width: 200rpx;
  height: 216rpx;
  border-radius: 12rpx;
  background: #eef0f3;
}

.item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-with-cover .item-body {
  min-height: 216rpx;
}

/* 标题：有图时预留两行（30rpx × 42rpx 行高），保证卡片等高；
   无图时按标题实际行数自然显示，不占空行 */
.item-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 42rpx;
  color: var(--color-text);
}

.item-with-cover .item-title {
  min-height: 84rpx;
}

/* 属性行：城东 | 2室1厅 | 89㎡，竖线分隔，单行不换行 */
.item-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-text-light);
  white-space: nowrap;
  overflow: hidden;
}

.meta-divider {
  margin: 0 10rpx;
  font-size: 20rpx;
  color: #d6dae1;
}

.item-price {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

/* 价格略大于标题（36rpx vs 30rpx） */
.price-num {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: var(--color-danger);
}

.price-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-light);
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

/* 有图时标签沉到最底，与图片下边缘对齐 */
.item-with-cover .item-tags {
  margin-top: auto;
}

.tag {
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 6rpx;
}

/* 管理员自定义标签：灰底，与系统类型标签区分 */
.tag-custom {
  color: #646a73;
  background: #f2f4f7;
}

.tag-ad {
  color: #b26a00;
  background: #fff4e0;
}

/* 招租信息标记「无中介」 */
.tag-agency {
  color: #1a9b52;
  background: #e8f7ee;
}

/* ---------------- 轮播图（独立于白色面板，直接贴在页面底色上） ---------------- */

/* 不放在 .sheet 里：白面板只承载分类入口和公告，轮播图作为独立卡片单独占据一段，
   与下方信息卡片同宽同圆角。上方 20rpx 灰底缝隙把它和白面板隔开。 */
.banner-box {
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f5f7fb;
}

/* 固定高度而不是按图比例：不同尺寸的图不会把首页顶得一跳一跳 */
.banner-swiper {
  width: 100%;
  height: 360rpx;
}

.banner-img {
  display: block;
  width: 100%;
  height: 100%;
  background: #f5f7fb;
}
