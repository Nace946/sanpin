<!-- packageAdmin/banners/banners.wxml -->
<view class="page">

  <view wx:if="{{checking}}" class="tip-wrap">正在校验身份…</view>

  <view wx:elif="{{!authed}}" class="tip-wrap">
    <view class="deny-title">无管理权限</view>
    <view class="deny-desc">轮播图管理仅限平台运营人员使用。</view>
    <view wx:if="{{openid}}" class="openid-box">
      <view class="openid-label">当前微信账号的 openid（加入云函数环境变量 ADMIN_OPENIDS 后重新部署即可获得权限）：</view>
      <view class="openid-value">{{openid}}</view>
    </view>
  </view>

  <block wx:else>
    <view class="intro">
      按下面的顺序在首页从上到下播放，最多 20 张；全部停用时首页轮播位自动隐藏。
      图片建议 750×380 左右（约 2:1）。<text class="intro-em">不跳转</text>的图用户点击可放大；
      <text class="intro-em">设了跳转</text>的图点击直接跳走，不放大。
    </view>

    <view wx:if="{{loading}}" class="tip-wrap">加载中…</view>

    <view wx:elif="{{list.length === 0}}" class="tip-wrap">
      <view class="deny-title">还没有轮播图</view>
      <view class="deny-desc">点下方「＋ 上传轮播图」添加第一张。</view>
    </view>

    <view wx:else class="list">
      <view class="card" wx:for="{{list}}" wx:key="_id">

        <!-- 图片外框：白底 + 细描边，与卡片背景分层 -->
        <view class="thumb-wrap">
          <view class="thumb-box">
            <image
              class="thumb"
              src="{{item.image}}"
              mode="aspectFill"
              data-index="{{index}}"
              bindtap="onThumbTap"
              lazy-load
            />
            <text class="hit-badge {{item.jumping ? 'hit-badge-jump' : ''}}">{{item.hitText}}</text>
          </view>
        </view>

        <view class="body">
          <view class="row">
            <text class="order">第 {{index + 1}} 张</text>
            <text class="state {{item.enabled ? 'state-on' : ''}}">{{item.enabled ? '启用中' : '已停用'}}</text>
          </view>

          <picker
            range="{{linkLabels}}"
            value="{{item.linkIndex}}"
            data-index="{{index}}"
            bindchange="onLinkChange"
          >
            <view class="picker-value">
              <text class="picker-label">点击行为</text>
              <text class="picker-current">{{linkLabels[item.linkIndex]}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>

          <!-- 站内页面：显示已配的路径，可再次修改 -->
          <view wx:if="{{item.linkType === 'page'}}" class="path-row">
            <text class="path-text {{item.linkValue ? '' : 'path-empty'}}">{{item.linkValue || '未填写路径，点右侧填写'}}</text>
            <text class="path-edit" data-index="{{index}}" bindtap="onEditPath">改路径</text>
          </view>

          <view class="ops">
            <text class="op" data-index="{{index}}" bindtap="onPreview">预览</text>
            <text class="op" data-index="{{index}}" data-dir="-1" bindtap="onMove">↑ 上移</text>
            <text class="op" data-index="{{index}}" data-dir="1" bindtap="onMove">↓ 下移</text>
            <text class="op" data-index="{{index}}" bindtap="onToggle">{{item.enabled ? '停用' : '启用'}}</text>
            <text class="op op-danger" data-index="{{index}}" bindtap="onRemove">删除</text>
          </view>
        </view>
      </view>
    </view>

    <view class="submit-bar">
      <button class="submit-btn" bindtap="onAdd" loading="{{busy}}" disabled="{{busy}}">
        {{busy ? '上传中…' : '＋ 上传轮播图'}}
      </button>
    </view>
  </block>

  <!-- 站内路径编辑弹窗 -->
  <view wx:if="{{editShow}}" class="mask" bindtap="onEditCancel">
    <view class="dialog" catchtap="onNoop">
      <view class="dialog-title">站内跳转路径</view>
      <view class="dialog-body">
        <input
          class="dialog-input"
          value="{{editValue}}"
          placeholder="/pages/detail/detail?id=xxx"
          placeholder-class="dialog-ph"
          bindinput="onEditInput"
        />
        <view class="dialog-tip">{{editTip}}</view>
      </view>
      <view class="dialog-ops">
        <text class="d-btn" bindtap="onEditPaste">粘贴</text>
        <text class="d-btn" bindtap="onEditCancel">取消</text>
        <text class="d-btn d-primary" bindtap="onEditConfirm">确定</text>
      </view>
    </view>
  </view>

</view>
